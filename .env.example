# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.

# PostgreSQL (matches docker-compose.yml; host port 5433 avoids clashing
# with a local Postgres on 5432)
DATABASE_URL=postgres://lost_in_space:lost_in_space@localhost:5433/lost_in_space

# Neon (and many managed providers) also offer a direct, non-pooled URL.
# Use the direct URL for schema changes and the ETL; the app can use the pooled one.
DATABASE_URL_UNPOOLED=

# Transport for lib/db.ts. `auto` sends *.neon.tech URLs over HTTPS/443
# (@neondatabase/serverless) and everything else through a native pg pool.
# Force it with `neon-http` or `pg` when a network blocks 5432.
# DB_DRIVER=auto

# NASA Image API key. Optional for basic use, recommended for volume.
# https://api.nasa.gov/
NASA_API_KEY=

# Identify this client to CelesTrak. Put a real contact URL/email here.
CELESTRAK_USER_AGENT=lost-in-space/0.1 (+https://github.com/T9039/Lost-In-Space)

# Public base URL, used for absolute links in generated content.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Frontend API origin. Leave empty to use the bundled fixtures.
# Set it to the API origin when the backend endpoints exist.
NEXT_PUBLIC_API_BASE=
