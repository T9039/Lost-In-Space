# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.

# PostgreSQL (matches docker-compose.yml; host port 5433 avoids clashing
# with a local Postgres on 5432)
DATABASE_URL=postgres://lost_in_space:lost_in_space@localhost:5433/lost_in_space

# NASA Image API key. Optional for basic use, recommended for volume.
# https://api.nasa.gov/
NASA_API_KEY=

# Identify this client to CelesTrak. Put a real contact URL/email here.
CELESTRAK_USER_AGENT=lost-in-space/0.1 (+https://github.com/T9039/Lost-In-Space)

# Public base URL, used for absolute links in generated content.
NEXT_PUBLIC_APP_URL=http://localhost:3000
